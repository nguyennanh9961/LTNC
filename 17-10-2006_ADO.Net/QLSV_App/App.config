<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <!-- Cấu hình kết nối CSDL theo Slide 17 -->
        <!-- Có thể chỉnh lại Data Source thành tên Server SQL trên máy (ví dụ: . hoặc .\SQLEXPRESS) -->
        <add name="studentDataBase" 
             connectionString="Data Source=.;Initial Catalog=QLSV;Integrated Security=True;TrustServerCertificate=True" 
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
