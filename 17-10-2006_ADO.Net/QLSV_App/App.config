<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <!-- CSDL Quản lý sinh viên (QLSVDbContext) -->
        <add name="studentDataBase" 
             connectionString="Data Source=.;Initial Catalog=QLSV;Integrated Security=True;TrustServerCertificate=True" 
             providerName="System.Data.SqlClient" />
        <!-- CSDL Quản lý thư viện (QLTVDBContext) -->
        <add name="libraryDataBase" 
             connectionString="Data Source=.;Initial Catalog=LibraryDB;Integrated Security=True;TrustServerCertificate=True" 
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
